# =====================================================
# UGC SaaS Platform - Environment Variables
# =====================================================
# Copy this file to .env and fill in your actual values
# Conceived by Romuald Członkowski - https://www.aiadvisors.pl/en

# =====================================================
# SUPABASE CONFIGURATION
# =====================================================
# Get these from your Supabase project settings

# Supabase Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon/Public Key (safe to expose to frontend)
SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (KEEP SECRET - server-side only)
# This bypasses Row Level Security - use carefully
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# =====================================================
# KIE.AI CONFIGURATION
# =====================================================
# For AI image generation (Nano-Banana, Seedream)

# Kie.ai API Base URL
KIE_API_URL=https://api.kie.ai

# Kie.ai API Key
KIE_API_KEY=your-kie-api-key-here

# Alternative: Use kieai.redpandaai.co if that's your endpoint
# KIE_API_URL=https://kieai.redpandaai.co

# =====================================================
# GOOGLE GEMINI CONFIGURATION
# =====================================================
# For AI analysis and prompt generation

# Google Gemini API Key
GEMINI_API_KEY=your-gemini-api-key-here

# =====================================================
# N8N CONFIGURATION
# =====================================================

# Your n8n instance URL (for generating status URLs)
# This is the public-facing URL where your frontend will call
API_BASE_URL=https://your-n8n-instance.com/webhook

# n8n Webhook Secret (optional, for webhook security)
N8N_WEBHOOK_SECRET=your-webhook-secret-here

# =====================================================
# STRIPE CONFIGURATION (Optional - for payments)
# =====================================================

# Stripe Secret Key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key

# Stripe Webhook Secret
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Stripe Price IDs
STRIPE_PRICE_ID_PRO_MONTHLY=price_xxx
STRIPE_PRICE_ID_PRO_YEARLY=price_xxx
STRIPE_PRICE_ID_ENTERPRISE_MONTHLY=price_xxx

# =====================================================
# APPLICATION SETTINGS
# =====================================================

# Environment
NODE_ENV=production

# Application Name
APP_NAME=UGC Video Generator

# Support Email
SUPPORT_EMAIL=support@your-saas.com

# Frontend URL (for CORS, redirects, etc.)
FRONTEND_URL=https://your-app.com

# =====================================================
# CREDITS & LIMITS
# =====================================================

# Credits per video generation
CREDITS_PER_VIDEO=10

# Free tier monthly credits
FREE_TIER_CREDITS=10

# Pro tier monthly credits
PRO_TIER_CREDITS=100

# Enterprise tier monthly credits
ENTERPRISE_TIER_CREDITS=1000

# =====================================================
# RATE LIMITING
# =====================================================

# Requests per hour by tier
RATE_LIMIT_FREE=5
RATE_LIMIT_PRO=60
RATE_LIMIT_ENTERPRISE=1000

# =====================================================
# VIDEO PROCESSING
# =====================================================

# Max video duration (seconds) by tier
MAX_DURATION_FREE=64
MAX_DURATION_PRO=64
MAX_DURATION_ENTERPRISE=300

# Max concurrent jobs by tier
MAX_CONCURRENT_JOBS_FREE=1
MAX_CONCURRENT_JOBS_PRO=3
MAX_CONCURRENT_JOBS_ENTERPRISE=10

# =====================================================
# LOGGING & MONITORING
# =====================================================

# Log level (error, warn, info, debug)
LOG_LEVEL=info

# Sentry DSN (optional - for error tracking)
SENTRY_DSN=

# =====================================================
# STORAGE
# =====================================================

# Supabase Storage Bucket Name
STORAGE_BUCKET_NAME=user-videos

# Max file upload size (bytes) - 10MB default
MAX_FILE_SIZE=10485760

# =====================================================
# WEBHOOK NOTIFICATIONS (Optional)
# =====================================================

# Enable webhook notifications
ENABLE_WEBHOOKS=false

# Webhook retry attempts
WEBHOOK_RETRY_ATTEMPTS=3

# Webhook timeout (milliseconds)
WEBHOOK_TIMEOUT=5000

# =====================================================
# SECURITY
# =====================================================

# JWT Secret (for additional token verification if needed)
JWT_SECRET=your-jwt-secret-here

# API Key Salt (for hashing user API keys)
API_KEY_SALT=your-api-key-salt-here

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=https://your-app.com,https://www.your-app.com

# =====================================================
# FEATURE FLAGS
# =====================================================

# Enable experimental features
ENABLE_EXPERIMENTAL_FEATURES=false

# Enable API access for enterprise tier
ENABLE_API_ACCESS=true

# Enable priority processing
ENABLE_PRIORITY_PROCESSING=true

# =====================================================
# ANALYTICS (Optional)
# =====================================================

# Google Analytics ID
GA_TRACKING_ID=

# Mixpanel Token
MIXPANEL_TOKEN=

# PostHog API Key
POSTHOG_API_KEY=

# =====================================================
# EMAIL (Optional - for notifications)
# =====================================================

# SendGrid API Key
SENDGRID_API_KEY=

# From Email Address
FROM_EMAIL=noreply@your-saas.com

# =====================================================
# DEVELOPMENT / DEBUG
# =====================================================

# Debug mode (verbose logging)
DEBUG=false

# Skip credit checks (for testing only!)
SKIP_CREDIT_CHECKS=false

# Mock AI generation (for testing without using credits)
MOCK_AI_GENERATION=false
